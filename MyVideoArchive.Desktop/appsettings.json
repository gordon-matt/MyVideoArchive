{
  "SeedAdmin": {
    "Email": "admin@myvideoarchive.local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "LogVue": {
    "Title": "MyVideoArchive",
    // Deletes log entries older than this many days. 0 keeps everything.
    "RetentionDays": 30
  },
  "AllowedHosts": "*",
  // Enables beta features (currently the Odysee and Rumble platforms). Requires an app restart.
  "EnableBetaFeatures": false,
  "VideoDownload": {
    "OutputPath": "Downloads",
    "VideoQuality": "bestvideo[height=720]+bestaudio/bestvideo[height=720]+bestaudio/bestvideo[height=480]+bestaudio/best",
    "Throttle": {
      "MinDelaySeconds": 10,
      "MaxDelaySeconds": 60,
      "BatchSize": 25,
      "BatchWindowMinutes": 30
    }
  },
  "YoutubeDL": {
    "ExecutablePath": null,
    "FFmpegPath": null
  },
  "Subtitles": {
    "Enabled": false,
    "Languages": "en.*,en",
    "IncludeAutoGenerated": true,
    "EmbedInVideo": false
  },
  "Tags": {
    "ImportTagsFromPlatform": false
  },
  "ConnectionStrings": {
    // Configure your database connection here, via User Secrets, or via the
    // ConnectionStrings__DefaultConnection environment variable. The desktop build
    // currently uses the same PostgreSQL provider as the web build.
    "DefaultConnection": ""
  }
}
