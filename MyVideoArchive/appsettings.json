{
  "SeedAdmin": {
    "Email": "admin@myvideoarchive.local"
    // "Password": "Admin@123"   ← override here or via SeedAdmin__Password env var
  },
  "Database": {
    // Database engine to use. One of: "Npgsql" (PostgreSQL, default), "SqlServer", "MySql", "Sqlite".
    // The connection string is always read from ConnectionStrings:DefaultConnection and must match
    // the selected provider. Override via env var Database__Provider (e.g. in Docker).
    // MySql note: append "Allow User Variables=True" to the connection string for Hangfire.
    "Provider": "Npgsql"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "VideoDownload": {
    "OutputPath": "D:\\Videos\\MyVideoArchive",
    //"VideoQuality": "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"
    // Height caps use "<=" (not "="), and include a "best[height<=N]" fallback for platforms
    // (e.g. Rumble) whose formats are already combined audio+video per resolution rather than
    // split video-only/audio-only streams — "bestvideo[height<=N]+bestaudio" never matches those,
    // silently falling through to the final unfiltered "best" and downloading full quality.
    // Note: this has no effect on platforms that only expose a single "original" quality with no
    // ladder to select from (e.g. Odysee/LBRY) — see VideoDownload:PostProcessDownscale below for
    // a post-download ffmpeg-based fallback for those.
    "VideoQuality": "bestvideo[height=720]+bestaudio/bestvideo[height=720]+bestaudio/bestvideo[height=480]+bestaudio/best",
    // After every successful download, run a fast ffmpeg check that the video stream can be read
    // without errors. Catches corruption (e.g. from a buggy remux) that plays fine sequentially
    // but throws a browser decode error on seek; a failure is retried like a rate limit (see
    // Throttle:MaxRateLimitRetries). Cheap for healthy files (no full decode).
    "VerifyDownloadIntegrity": true,
    // Post-download safety net: transcodes a video down with ffmpeg when it's taller than
    // MaxHeight. Only needed for platforms whose yt-dlp format ladder can't be restricted at
    // download time (see the VideoQuality comment above, e.g. Odysee). Disabled by default since
    // transcoding is CPU/time-intensive; enable if you need those platforms' files to shrink too.
    "PostProcessDownscale": {
      "Enabled": true,
      "MaxHeight": 720,
      // libx264 constant-rate-factor: lower = higher quality/bigger file (typical range 18-28).
      "Crf": 23,
      // libx264 preset: slower presets compress better at the same Crf. One of ultrafast,
      // superfast, veryfast, faster, fast, medium, slow, slower, veryslow.
      "Preset": "medium"
    },
    "Throttle": {
      "MinDelaySeconds": 10,
      "MaxDelaySeconds": 60,
      "BatchSize": 25,
      "BatchWindowMinutes": 30,
      // When a download hits a transient error (e.g. HTTP 429 "Too Many Requests"), it is
      // rescheduled with exponential backoff (2, 4, 8, ... up to 60 min) instead of being
      // marked permanently failed. After this many rate-limit retries the video is failed.
      "MaxRateLimitRetries": 6
    },
    // Odysee's LBRY backend rate-limits by IP (HTTP 429), and once tripped the block lasts a
    // while. These yt-dlp knobs pace ALL Odysee traffic (downloads, metadata fetches, subtitle
    // fetches) to avoid tripping the limiter. All optional; sensible defaults apply.
    "Odysee": {
      // Seconds yt-dlp sleeps between HTTP requests (--sleep-requests).
      "SleepRequestsSeconds": 2,
      // Random pre-download sleep window (--sleep-interval / --max-sleep-interval).
      "MinSleepSeconds": 3,
      "MaxSleepSeconds": 10,
      // yt-dlp extractor retries on transient extractor/HTTP errors (--extractor-retries).
      // Note: the LBRY streaming-URL checks are non-fatal requests that yt-dlp never retries,
      // so a 429 there still fails the attempt — the download job's exponential reschedule
      // (see Throttle:MaxRateLimitRetries above) is what recovers from that.
      "ExtractorRetries": 5,
      // Optional: path to a Netscape-format cookies.txt exported from a browser session on
      // odysee.com. The yt-dlp lbry extractor forwards the "auth_token" cookie as
      // x-lbry-auth-token, authenticating API calls — authenticated traffic gets much better
      // rate-limit treatment. Recommended if 429s persist.
      "CookiesFilePath": "D:\\Videos\\MyVideoArchive\\odysee.com_cookies.txt"
      // Optional: force IPv4 (--force-ipv4). Reported to resolve lbry 429s on some networks
      // where IPv6 ranges are aggressively blocked.
      // "ForceIPv4": true
    }
  },
  "YoutubeDL": {
    "ExecutablePath": null,
    "FFmpegPath": null,
    // Where the previous yt-dlp install is backed up before every update (scheduled or
    // manual), so an admin can roll back to it from Admin → Tools → yt-dlp without a redeploy.
    // Defaults to "<VideoDownload:OutputPath>/_System/yt-dlp-backup" — inside the persisted
    // downloads volume, so the backup survives container recreation even in Docker, where the
    // yt-dlp executable itself does not. Override only if you want it stored elsewhere.
    // "BackupPath": "D:\\Videos\\MyVideoArchive\\_System\\yt-dlp-backup",
    // Automatically keeps yt-dlp current. YouTube changes its internal APIs often, and an
    // out-of-date yt-dlp starts failing channel/playlist fetches (HTTP 400/404 "invalid
    // argument"). A weekly Hangfire job ("yt-dlp-update") applies the latest release; it can
    // also be triggered manually from Admin → Tools → yt-dlp (or the /hangfire dashboard).
    "AutoUpdate": {
      // Set to false to disable the recurring update job.
      "Enabled": true,
      // How to update. "Auto" (default) infers the right method: when ExecutablePath is set
      // (e.g. the Docker image installs yt-dlp via pip) it upgrades through pip; otherwise it
      // self-updates the standalone binary via "yt-dlp -U". Override with "Self", "Pip" or
      // "Binary" (re-download the latest standalone binary via YoutubeDLSharp).
      "Method": "Auto"
      // Optional pip overrides (only used by the Pip method):
      // "PipExecutable": "pip3",
      // "PipArguments": "install --break-system-packages --no-cache-dir --upgrade",
      // "PipPackage": "yt-dlp[default]"
    },
    // Paces channel/playlist/video *metadata* lookups (as opposed to actual downloads, which
    // are already throttled separately below). Without this, subscribing to several playlists
    // at once queues one Hangfire job per playlist with no concurrency limit, so many yt-dlp
    // "browse" requests can hit YouTube in parallel from the same IP — which is what triggers
    // "HTTP Error 404" followed by "HTTP Error 400: Request contains an invalid argument" on
    // some (but not all) playlists/channels. All metadata requests are also serialized
    // (never run concurrently), on top of this delay between them.
    "MetadataThrottle": {
      "MinDelaySeconds": 3,
      "MaxDelaySeconds": 8
    }
    // Advanced/optional: pass extra yt-dlp --extractor-args to every YouTube request (metadata
    // and downloads). Useful as a manual workaround if YouTube starts rejecting a particular
    // player client again (see https://github.com/yt-dlp/yt-dlp/wiki/Extractors). Example:
    // "ExtractorArgs": [ "youtube:player_client=default,-ios" ]
  },
  "Subtitles": {
    // When true, yt-dlp downloads subtitles alongside each video as sidecar .vtt
    // files named "<videoId>.<lang>.vtt". They're served to the video.js player
    // through /api/videos/{id}/subtitles.
    "Enabled": true,
    // Comma-separated yt-dlp language filter (supports patterns, e.g. "en.*,en").
    // "all" pulls every available language.
    "Languages": "en.*,en",
    // Also download YouTube's auto-generated captions when no manual subs exist.
    "IncludeAutoGenerated": true,
    // Embed subtitles in the video container (mp4/webm/mkv). Sidecar .vtt files
    // are still written so video.js can render them natively.
    "EmbedInVideo": false
  },
  "Tags": {
    // When true, platform tags (e.g. YouTube video/channel/playlist tags) are imported
    // automatically on first subscribe. Import only runs once — if a channel/playlist/video
    // already has any tags, the import is skipped so that manual tag edits are preserved.
    "ImportTagsFromPlatform": false
  }

  // ── Optional: Keycloak authentication ──────────────────────────────────────
  // By default the app uses built-in ASP.NET Core Identity (local user database).
  // To use Keycloak instead, uncomment the block below and fill in your values.
  // See docs/KEYCLOAK_SETUP.md for step-by-step Keycloak configuration instructions.
  //
  // "Authentication": {
  //   "Provider": "Keycloak",
  //   "Keycloak": {
  //     // Authority: public Keycloak realm URL — used by the browser for login AND by the
  //     // app container for backchannel calls (discovery, token exchange).
  //     // The container must be able to reach this URL; use extra_hosts in docker-compose
  //     // when Keycloak is in a separate stack behind a reverse proxy (see docker-compose.yml).
  //     // Format: http(s)://<host>:<port>/realms/<realm-name>
  //     "Authority": "http://localhost:8081/realms/myvideoarchive",
  //
  //     // ClientId must match the client you created in Keycloak.
  //     "ClientId": "myvideoarchive",
  //
  //     // ClientSecret: copy from Keycloak → Clients → myvideoarchive → Credentials tab.
  //     // Never commit this value. Use User Secrets (dev) or an environment variable (prod).
  //     "ClientSecret": "replace-with-your-client-secret"
  //
  //     // Optional: Keycloak Admin API credentials used for looking up user details.
  //     // The client must have a service account with the realm-management → view-users role.
  //     // If omitted, falls back to ClientId/ClientSecret above (if that client has a service account).
  //     // "AdminClientId": "myvideoarchive-admin",
  //     // "AdminClientSecret": "replace-with-admin-client-secret",
  //
  //     // Optional: set to the app's public HTTPS URL (e.g. https://mva.example.com) when the
  //     // reverse proxy does not forward X-Forwarded-Proto and the app sends http:// in redirect_uri.
  //     // Not needed if forwarded headers are working correctly.
  //     // "PublicOrigin": "https://mva.example.com",
  //
  //     // Optional: when the app container cannot reach the public Keycloak hostname (e.g.
  //     // Docker hairpin NAT), set this to the internal URL where the container can reach
  //     // Keycloak directly. All backchannel calls (discovery, token exchange) are rerouted
  //     // there while Authority stays public for browser-facing login redirects.
  //     // Example (same Docker network, using container name): "http://keycloak:8080"
  //     // "BackchannelBaseUrl": "http://keycloak:8080"
  //   }
  // }
}